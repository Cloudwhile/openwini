# ===== 后端（crates/api）必需环境变量 =====
# 数据库：外部 PostgreSQL 实例，分键配置（密码无需 URL 编码）
DB_HOST=localhost
DB_PORT=5432
DB_USER=wini
DB_PASSWORD=wini
DB_NAME=wini_plugins
# 备选：单条连接串（分键存在时忽略）
# DATABASE_URL=postgres://wini:wini@localhost:5432/wini_plugins

# 应用级加密密钥：32 字节十六进制（64 字符）。用于加密 GitHub Token、SMTP 密码、AI Key。
# 生成方式：openssl rand -hex 32
APP_ENCRYPTION_KEY=

# GitHub OAuth App（回调地址填 {APP_BASE_URL}/api/auth/github/callback）
# 授权范围固定为 read:user user:email public_repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== 引导管理员（可配置一位或多位；管理员可审批自己的申请，审计全程记录）=====
# 逗号分隔的 GitHub 登录名；这些账号首次登录即成为管理员。此后可在后台授予/收回。
# 环境变量只授予、不收回。
ADMIN_GITHUB_LOGINS=

# 唯一拥有官方身份（winiofficial，system 权限）的 GitHub 用户名（可选）
# 该账号登录后自动绑定官方身份，可走官方直发流程
OFFICIAL_GITHUB_LOGIN=

# ===== 可选 =====
# 本地开发为 development；Docker Compose 固定使用 production。
APP_ENV=development
# 监听地址
BIND_ADDR=0.0.0.0:8080
# 前端生产产物目录；留空时只提供 API，Compose 固定使用 /web。
WEB_DIST_DIR=
# 前端基地址（OAuth 回跳与邮件里的详情链接）
APP_BASE_URL=http://localhost:3000
# 本地 http 调试时设为 false；生产必须 true
COOKIE_SECURE=false
RUST_LOG=wini_api=info

# 逗号分隔的受信代理 IP；默认留空，仅使用直连地址。
# 需要使用代理传递的客户端 IP 时，填写外部反向代理在共享网络中的实际 IP。
# 反向代理容器重建后需重新核对，并重建 API 容器以应用配置。
TRUSTED_PROXY_IPS=

# ===== Docker Compose 部署 =====
# 正式部署必须把 APP_BASE_URL 改为 https://你的正式域名，并完成 GitHub OAuth 配置。
# DB_HOST 指向容器可访问的外部数据库地址；localhost 在容器内不是宿主机。
# Compose 自动拉取官方镜像并编译源码，无需配置应用镜像。
# 服务间使用 Compose 默认网络，不指定网络名、网段或固定 IP。
# Rust 服务在容器内通过 10180 统一提供页面和 API。
# 默认不向宿主机发布端口；部署后使用 docker network connect 将 API 容器接入代理网络。
